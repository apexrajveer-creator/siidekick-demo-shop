diff --git a/.github/workflows/siidekick.yml b/.github/workflows/siidekick.yml
new file mode 100644
--- /dev/null
+++ b/.github/workflows/siidekick.yml
@@ -0,0 +1,18 @@
+name: Siidekick
+
+on:
+  push:
+    branches: [main]
+  pull_request:
+
+jobs:
+  test:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-node@v4
+        with:
+          node-version: 20
+      - run: npm ci
+      - run: npm test --if-present
+      - run: npm audit --audit-level=high || true
